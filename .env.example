# Copy to .env. Never commit real keys. Keys are supplied via environment variables only.
# Primary: NVIDIA build endpoint (OpenAI-compatible)
LLM_PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
# Fallback: Gemini Flash-Lite via Google AI Studio (OpenAI-compatible endpoint)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Run limits (internal safety limits; official limits are not published)
REQUEST_BUDGET_TOTAL=2000
REQUEST_BUDGET_PER_COMPANY=15
WALL_CLOCK_SECONDS=2700
MAX_WORKERS=8
LLM_TIMEOUT_SECONDS=90
